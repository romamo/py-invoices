{#- Shared UBL parts. Expects `invoice`, `company` and `totals` in the context. -#}
{% macro amount(money) %}{{ money|cents }}{% endmacro %}
{% macro supplier() %}
    <cac:AccountingSupplierParty>
        <cac:Party>
            <cac:PartyName>
                <cbc:Name>{{ company.name }}</cbc:Name>
            </cac:PartyName>
            <cac:PostalAddress>
                <cbc:StreetName>{{ company.address|default('', true) }}</cbc:StreetName>
                {% if company.city %}<cbc:CityName>{{ company.city }}</cbc:CityName>{% endif %}
                {% if company.postal_code %}<cbc:PostalZone>{{ company.postal_code }}</cbc:PostalZone>{% endif %}
                {% if company.country_code %}
                <cac:Country>
                    <cbc:IdentificationCode>{{ company.country_code }}</cbc:IdentificationCode>
                </cac:Country>
                {% endif %}
            </cac:PostalAddress>
            {% if company.tax_id %}
            <cac:PartyTaxScheme>
                <cbc:CompanyID>{{ company.tax_id }}</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            {% endif %}
        </cac:Party>
    </cac:AccountingSupplierParty>
{% endmacro %}
{% macro customer() %}
    <cac:AccountingCustomerParty>
        <cac:Party>
            <cac:PartyName>
                <cbc:Name>{{ invoice.client_name_snapshot|default('', true) }}</cbc:Name>
            </cac:PartyName>
            <cac:PostalAddress>
                <cbc:StreetName>{{ invoice.client_address_snapshot|default('', true) }}</cbc:StreetName>
            </cac:PostalAddress>
            {% if invoice.client_tax_id_snapshot %}
            <cac:PartyTaxScheme>
                <cbc:CompanyID>{{ invoice.client_tax_id_snapshot }}</cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            {% endif %}
        </cac:Party>
    </cac:AccountingCustomerParty>
{% endmacro %}
{% macro tax_category(rate) %}
                <cbc:ID>{{ 'S' if rate else 'Z' }}</cbc:ID>
                <cbc:Percent>{{ rate }}</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>VAT</cbc:ID>
                </cac:TaxScheme>
{% endmacro %}
{% macro tax_and_totals() %}
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="{{ totals.currency }}">{{ amount(totals.tax) }}</cbc:TaxAmount>
        {% for subtotal in totals.tax_subtotals %}
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="{{ totals.currency }}">{{ amount(subtotal.taxable) }}</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="{{ totals.currency }}">{{ amount(subtotal.tax) }}</cbc:TaxAmount>
            <cac:TaxCategory>
{{ tax_category(subtotal.rate) }}
            </cac:TaxCategory>
        </cac:TaxSubtotal>
        {% endfor %}
    </cac:TaxTotal>

    <cac:LegalMonetaryTotal>
        <cbc:LineExtensionAmount currencyID="{{ totals.currency }}">{{ amount(totals.net) }}</cbc:LineExtensionAmount>
        <cbc:TaxExclusiveAmount currencyID="{{ totals.currency }}">{{ amount(totals.net) }}</cbc:TaxExclusiveAmount>
        <cbc:TaxInclusiveAmount currencyID="{{ totals.currency }}">{{ amount(totals.gross) }}</cbc:TaxInclusiveAmount>
        <cbc:PayableAmount currencyID="{{ totals.currency }}">{{ amount(totals.gross) }}</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>
{% endmacro %}
{% macro line_body(line) %}
        <cbc:LineExtensionAmount currencyID="{{ totals.currency }}">{{ amount(line_net(line)) }}</cbc:LineExtensionAmount>
        <cac:Item>
            <cbc:Description>{{ line.description }}</cbc:Description>
            <cbc:Name>{{ line.description }}</cbc:Name>
            <cac:ClassifiedTaxCategory>
{{ tax_category(line.tax_rate or 0) }}
            </cac:ClassifiedTaxCategory>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="{{ totals.currency }}">{{ line.unit_price.amount }}</cbc:PriceAmount>
        </cac:Price>
{% endmacro %}
