# Backend configuration
INVOICES_BACKEND=memory
# INVOICES_BACKEND=sqlite
# INVOICES_BACKEND=postgres
# INVOICES_BACKEND=files

# Files backend configuration
# INVOICES_FILE_FORMAT=md
# INVOICES_STORAGE_PATH=./data

# Database configuration (for sqlite/postgres backends)
# INVOICES_DATABASE_URL=sqlite:///invoices.db
# INVOICES_DATABASE_URL=postgresql://user:pass@localhost/invoices
INVOICES_DATABASE_ECHO=false

# PDF generation
# Optional: defaults to package included template
# INVOICES_TEMPLATE_DIR=templates
# INVOICES_OUTPUT_DIR=output

# HTTP API: required key for every request (sent as the X-API-Key header)
# INVOICES_API_KEY=change-me
# Extra browser origins allowed to call the API, as a JSON list
# INVOICES_CORS_ORIGINS=["https://invoices.example.com"]
